# Strict persistent count caps: only 0 or 1 accepted; defaults are zero.
PAID_TEST_MAX_AGENT_CALLS=0
PAID_TEST_MAX_IMAGE_CALLS=0
PAID_TEST_MAX_WORLD_CALLS=0
# Estimate reservation, not a provider-side financial spending limit.
PAID_TEST_BUDGET_USD=0
