# Documentation only: server does not auto-load this file.
# Enter secrets only in a local hidden terminal prompt, never chat or shell history.
PORT=4317
HOST=127.0.0.1
ALLOW_PAID_PROVIDERS=0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-1.5
WORLDLABS_API_KEY=
